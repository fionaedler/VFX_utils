'''
Creates an object merge node for each selected null node and automatically sets its references.
If a selected node is not a null one is created first and inserted into the network accordingly
'''

def createNull():
    node = hou.pwd()
    
    ### lets you call this function on any context ###     
    for i in hou.selectedNodes():
        if hou.nodeTypeCategories().keys():     


            ### get outputs   
            parent_ocs=i.outputConnections()       
            ###set new node params
            dir = i.parent().path() + "/"
            selNodeName = i.name()
            nodeinfo = i.type().name()
            
            init_content="OUT"
            #init_content="OUT_%s"%selNodeName
            otherName = hou.ui.readInput("Create Null Node for %s"%selNodeName, buttons=( "OK", "CANCEL"), initial_contents =init_content)
            if otherName[0]==1:
                break;
            otherName = otherName[1].upper().replace(" ", "_");
        
            #create new null
            nullNode = hou.node("/%s"%dir).createNode("null", otherName)
            nullNode.setColor(hou.Color( [0,0.3,0]))
    
            #setting Node position
            selNodePos = i.position()
            nullNode.setPosition(hou.Vector2(selNodePos[0], selNodePos[1]-1))
            nullNode.setInput(0, i)
            i.setSelected(False)
            nullNode.setSelected(True)
            
            for oc in parent_ocs:
                idx = oc.inputIndex()
                if oc.inputItem().name()==i.name():
                    oc.outputItem().setInput(idx, nullNode, 0)

            return nullNode 
    
                    
#################################################                   
                   
for node in hou.selectedNodes():
    nodeType = node.type().name()
    if(nodeType != "null"):
        node = createNull()

        
    newName = "om_"+ node.name().upper()
    selNodePos = node.position()    
    parentDir = node.parent().path() + "/"
    nodeDir = "../%s"%node
    newNode = hou.node("/%s"%parentDir).createNode("object_merge", newName)
    
    newNode.setPosition(hou.Vector2(selNodePos[0]+1.5,selNodePos[1]-1))  
    newNode.parm("objpath1").set("../%s"%node)        
    newNode.setUserData("nodeshape", "chevron_down")
    newNode.setColor(hou.Color( [0,0,0.4]))
    
    node.setSelected(False)
    newNode.setSelected(True)
