#Get range of frames available in folder
def get_range (folder):
    framelist = [i[ -8:-4] for i in os.listdir (folder)]
    return (framelist[0], framelist[-1])
def getShotFromScriptName():
    nScript = nuke.scriptName()
    list = nScript.split("/")
    shot = list [6]
    return shot

